# tempgba_me — no function exports on purpose (gbadhoc ADR-0080): the app
# parameterises the PRX through sceKernelStartModule args and talks
# through the mailbox afterwards.  Only the mandatory syslib block.
PSP_BEGIN_EXPORTS

PSP_EXPORT_START(syslib, 0, 0x8000)
PSP_EXPORT_FUNC_HASH(module_start)
PSP_EXPORT_FUNC_HASH(module_stop)
PSP_EXPORT_VAR_HASH(module_info)
PSP_EXPORT_END

PSP_END_EXPORTS
